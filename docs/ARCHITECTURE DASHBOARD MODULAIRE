export default function Dashboard() {
  const { user } = useAuth();
  const userRole = user?.user_metadata?.role || 'participant';

  switch (userRole) {
    case 'organisateur':
      return <OrganisateurDashboard />;
    case 'admin':
      return <AdminDashboard />;
    case 'participant':
    default:
      return <ParticipantDashboard />;
  }
}
